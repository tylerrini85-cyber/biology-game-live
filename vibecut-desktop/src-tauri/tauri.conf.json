{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeCut",
  "version": "0.1.0",
  "identifier": "com.vibecut.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "VibeCut",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
